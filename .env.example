# Copy this file to .env and paste your keys after the = signs. .env is never committed.
# Google AI Studio key, for Nano Banana (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Black Forest Labs key, for FLUX (https://dashboard.bfl.ai)
BFL_API_KEY=
# Or, instead of the two keys above: one Replicate token runs both models (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=
